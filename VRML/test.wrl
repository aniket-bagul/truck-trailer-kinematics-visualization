#VRML V2.0 utf8
WorldInfo { title "Truck‑Trailer with Rotating Wheels" }

NavigationInfo { type ["EXAMINE", "ANY"] }
Background      { skyColor [0.8 0.9 1] }

Viewpoint {
  description "Top View"
  position 0 40 80
  orientation 1 0 0 -0.7
}

# ──────────────────── Animation nodes ────────────────────
DEF WheelTimer TimeSensor {
  cycleInterval 1          # 2 s per full wheel revolution
  loop TRUE
}

DEF WheelSpinInterpolator OrientationInterpolator {
  key      [0 0.5 1]       # 0 → 180° → 360°
  keyValue [
    0 0 1 0,
    0 0 1 3.14159,
    0 0 1 6.28318
  ]
}

# ──────────────────── Ground plane (lowered) ──────────────
Transform {
  translation 0 -6.1 0      # moved down so wheels clear
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0 0.4 0 } }
      geometry   Box { size 160 0.2 160 }
    }
  ]
}

# ═══════════════════ TRUCK ════════════════════════════════
DEF TruckInstance Transform {
  translation 0 0 0
  children [

    # Body
    Shape {
      appearance Appearance { material Material { diffuseColor 1 0 0 } }
      geometry   Box { size 16 4.8 9.6 }
    }

    # ── Front‑right wheel ──
    DEF TruckWheelFR_Offset Transform {
      translation 7.2 -2.4 4.8
      children [
        Transform { rotation 1 0 0 1.5708   # turn cylinder on its side
          children [
            DEF TruckWheelFR_Spin Transform {           # animated
              rotation 0 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material { diffuseColor 0.1 0.1 0.1 }
                    texture  ImageTexture { url "../Textures/wheel_texture.png" }
                  }
                  geometry Cylinder { radius 3.2 height 0.96 }
                }
              ]
            }
          ]
        }
      ]
    }

    # ── Front‑left wheel ──
    DEF TruckWheelFL_Offset Transform {
      translation 7.2 -2.4 -4.8
      children [
        Transform { rotation 1 0 0 1.5708
          children [
            DEF TruckWheelFL_Spin Transform {
              rotation 0 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material { diffuseColor 0.1 0.1 0.1 }
                    texture  ImageTexture { url "../Textures/wheel_texture.png" }
                  }
                  geometry Cylinder { radius 3.2 height 0.96 }
                }
              ]
            }
          ]
        }
      ]
    }

    # ── Connecting rod (static; MATLAB can animate) ──
    DEF ConnectingInstance Transform {
      translation -5.5 0 0
      children [
        Transform { rotation 0 0 1 -1.5708
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 0 1 0 } }
              geometry   Cylinder { radius 0.6 height 12 }
            }
          ]
        }
      ]
    }
  ]
}

# ═══════════════════ TRAILER ══════════════════════════════
DEF TrailerInstance Transform {
  translation -22 0 0
  children [

    # Body
    Shape {
      appearance Appearance { material Material { diffuseColor 0 0 1 } }
      geometry   Box { size 22.4 4.8 9.6 }
    }

    # ── Trailer wheels (front & rear, left & right) ──
    DEF TrailerWheelFL_Offset Transform {
      translation -5.6 -2.4 4.8
      children [
        Transform { rotation 1 0 0 1.5708
          children [
            DEF TrailerWheelFL_Spin Transform {
              rotation 0 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material { diffuseColor 0.1 0.1 0.1 }
                    texture  ImageTexture {url "../Textures/wheel_texture.png" }
                  }
                  geometry Cylinder { radius 3.2 height 0.96 }
                }
              ]
            }
          ]
        }
      ]
    }

    DEF TrailerWheelFR_Offset Transform {
      translation -5.6 -2.4 -4.8
      children [
        Transform { rotation 1 0 0 1.5708
          children [
            DEF TrailerWheelFR_Spin Transform {
              rotation 0 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material { diffuseColor 0.1 0.1 0.1 }
                    texture  ImageTexture {url "../Textures/wheel_texture.png" }
                  }
                  geometry Cylinder { radius 3.2 height 0.96 }
                }
              ]
            }
          ]
        }
      ]
    }

    DEF TrailerWheelRL_Offset Transform {
      translation 5.6 -2.4 4.8
      children [
        Transform { rotation 1 0 0 1.5708
          children [
            DEF TrailerWheelRL_Spin Transform {
              rotation 0 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material { diffuseColor 0.1 0.1 0.1 }
                    texture  ImageTexture {url "../Textures/wheel_texture.png" }
                  }
                  geometry Cylinder { radius 3.2 height 0.96 }
                }
              ]
            }
          ]
        }
      ]
    }

    DEF TrailerWheelRR_Offset Transform {
      translation 5.6 -2.4 -4.8
      children [
        Transform { rotation 1 0 0 1.5708
          children [
            DEF TrailerWheelRR_Spin Transform {
              rotation 0 0 1 0
              children [
                Shape {
                  appearance Appearance {
                    material Material { diffuseColor 0.1 0.1 0.1 }
                    texture  ImageTexture {url "../Textures/wheel_texture.png" }
                  }
                  geometry Cylinder { radius 3.2 height 0.96 }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

# ──────────────────── ROUTEs ──────────────────────────────
ROUTE WheelTimer.fraction_changed TO WheelSpinInterpolator.set_fraction

# Truck wheels
ROUTE WheelSpinInterpolator.value_changed TO TruckWheelFR_Spin.set_rotation
ROUTE WheelSpinInterpolator.value_changed TO TruckWheelFL_Spin.set_rotation

# Trailer wheels
ROUTE WheelSpinInterpolator.value_changed TO TrailerWheelFL_Spin.set_rotation
ROUTE WheelSpinInterpolator.value_changed TO TrailerWheelFR_Spin.set_rotation
ROUTE WheelSpinInterpolator.value_changed TO TrailerWheelRL_Spin.set_rotation
ROUTE WheelSpinInterpolator.value_changed TO TrailerWheelRR_Spin.set_rotation
